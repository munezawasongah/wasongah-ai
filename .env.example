# ================================================
#   WasongahAI — Environment Variables
#   Copy this to .env and fill in all values
# ================================================

# ── Anthropic ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Server ─────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# ── Supabase (get from supabase.com dashboard) ─
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── JWT Secret (make this a long random string) ─
JWT_SECRET=change-this-to-a-very-long-random-secret-string-minimum-32-chars

# ── Stripe (get from dashboard.stripe.com) ─────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── M-Pesa Daraja (get from developer.safaricom.co.ke) ──
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-backend.up.railway.app/api/payments/mpesa/callback
MPESA_ENV=sandbox

# ── Credit Packages (cost in tokens per credit) ─
CREDITS_PER_CHAT=2
CREDITS_PER_TOOL=3
CREDITS_PER_IMAGE=5

# ── Rate Limiting ──────────────────────────────
RATE_LIMIT_PER_MINUTE=60
MAX_TOKENS=1500
