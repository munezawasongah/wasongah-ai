GEMINI_API_KEY=your-google-ai-studio-key
# Optional
PORT=3000
FRONTEND_URL=*
GEMINI_MODEL=gemini-3.8-flash
MAX_TOKENS=4096

# Video generation (Google Veo, paid tier of the Gemini API only)
VIDEO_DAILY_BUDGET_USD=10
# VEO_MODEL_LITE=veo-3.1-lite-generate-preview
# VEO_MODEL_FAST=veo-3.1-fast-generate-preview
# VEO_MODEL_STANDARD=veo-3.1-generate-preview

# Image Creator (Google Nano Banana models, paid tier). Combined daily spend cap in USD:
IMAGE_DAILY_BUDGET_USD=3
# IMAGE_MODEL_STANDARD=gemini-nano-banana-2.1
# IMAGE_MODEL_PRO=gemini-3-pro-image

# Optional bot protection (Cloudflare Turnstile). Both must be set to turn it on:
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
